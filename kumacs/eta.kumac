macro eta
null -300 300 0 250
atitle 'Z(cm)' 'Y(cm)'
dcut cave x 0 0 0 1 1
*  eta = 0.5    tanl^-1 =  1.91903 
*  eta = 1      tanl^-1 =  0.850918
*  eta = 1.5    tanl^-1 =  0.469642
*  eta = 2      tanl^-1 =  0.275721
*  eta = 2.5    tanl^-1 =  0.165284
*  eta = -0.5   tanl^-1 = -1.91903 
*  eta = -1     tanl^-1 = -0.850918
*  eta = -1.5   tanl^-1 = -0.469642
*  eta = -2     tanl^-1 = -0.275721
*  eta = -2.5   tanl^-1 = -0.165284
fun/plot  1.919030*x  0 300 sc
fun/plot  0.850918*x  0 300 sc
fun/plot  0.469642*x  0 300 sc
fun/plot  0.275721*x  0 300 sc
fun/plot  0.165284*x  0 300 sc
fun/plot -1.919030*(x-200) -300 300 sc
fun/plot -0.850918*(x-200) -300 300 sc
fun/plot -0.469642*(x-200) -300 300 sc
fun/plot -0.275721*(x-200) -300 300 sc
fun/plot -0.165284*(x-200) -300 300 sc
return
